#!/usr/bin/env bash
# Pre-push gate. Local green is the completion signal; CI is confirmation.
#
# Activate on a fresh clone with:  make install-hooks
# (sets core.hooksPath=hooks, so this actually fires)
#
# Two tiers, promoted automatically. A diff touching build inputs, the lock
# file or workflow definitions gets the deep gate, because those are the paths
# ci-local cannot fully cover by construction. Here ci-local-deep is ci-local,
# and the promotion is kept so the two tiers read as they do in every other
# Open Meridian repository.
#
# --no-verify bypasses this. It is not recommended and settings.json denies it
# to agent sessions.

set -euo pipefail

RISKY='(^|/)(Dockerfile[^/]*|Makefile|package(-lock)?\.json|\.github/workflows/)'

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
if [ -n "$upstream" ]; then
  changed="$(git diff --name-only "$upstream"...HEAD 2>/dev/null || true)"
else
  changed="$(git diff --name-only HEAD 2>/dev/null || true)"
fi

target="ci-local"
if echo "$changed" | grep -qE "$RISKY"; then
  target="ci-local-deep"
  echo "pre-push: diff touches a risky path, promoting to $target"
fi

# A failing run's output is kept, with the step logs it wrote (.test.log,
# .bench.log, .fit.log), in the git directory, so a block can be read after
# the fact even when whoever pushed kept only a line of what was printed.
# The ten newest failures are kept; a passing run keeps nothing.
logs="$(git rev-parse --path-format=absolute --git-path pre-push-logs)"
mkdir -p "$logs"
run="$logs/$(date -u +%Y%m%dT%H%M%SZ)-$target"
mkdir -p "$run"

echo "pre-push: running make $target"
if ! make "$target" 2>&1 | tee "$run/make.log"; then
  # Only the step logs this run wrote, not an earlier run's.
  find . -maxdepth 1 -name '.*.log' -newer "$run" -exec cp {} "$run/" \;
  ls -1d "$logs"/*/ 2>/dev/null | sort -r | tail -n +11 | xargs rm -rf
  echo
  echo "pre-push: BLOCKED -- make $target failed; its output is in $run/"
  echo "Fix it locally. Pushing red turns CI into a remote debugger."
  exit 1
fi
rm -rf "$run"
