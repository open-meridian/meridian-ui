# The kit's build, lint and tests, in a container, because the host has no
# toolchain to rely on (meridian-python and meridian-snaptrade do the same).
# `make` runs this image with `docker run`, so the design repository's tokens
# can be mounted where they exist, and streams dist/ and generated/ back out
# as a tar rather than writing through a bind mount.
ARG NODE_VERSION=22.23.3
FROM node:${NODE_VERSION}-alpine AS base
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
WORKDIR /w
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY contract contract
COPY generated generated
COPY schemes schemes
COPY src src
COPY tools tools
COPY tests tests

# The benchmark's browser: Playwright's image, pinned by version and digest,
# with the Chromium that playwright-core 1.63.0 (package-lock.json) drives.
# The two move together. Chromium does not run on Alpine, hence a second base.
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27 AS bench
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
WORKDIR /w
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY contract contract
COPY generated generated
COPY schemes schemes
COPY src src
COPY tools tools
COPY tests tests
